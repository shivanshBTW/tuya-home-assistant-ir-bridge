# Copy to backend/.env — never commit .env
HOST=0.0.0.0
PORT=8787
API_TOKEN=replace-with-a-long-random-token
DATA_DIR=../data

TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Region: https://openapi.tuyaus.com | https://openapi.tuyaeu.com | https://openapi.tuyacn.com | https://openapi.tuyain.com
TUYA_API_ENDPOINT=https://openapi.tuyaus.com
TUYA_IR_DEVICE_ID=

TUYA_LOCAL_IP=
# Used only when TUYA_LOCAL_IP is empty: look up this MAC on the LAN (arp / ping)
TUYA_LOCAL_MAC=
TUYA_LOCAL_KEY=
TUYA_LOCAL_VERSION=3.3

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
