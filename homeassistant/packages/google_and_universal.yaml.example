# Optional: combine a mapped TV media_player (power/input) with a soundbar
# (volume) after MQTT discovery creates the two entities.
#
# media_player:
#   - platform: universal
#     name: Living Room TV
#     device_class: tv
#     children:
#       - media_player.living_room_tv
#       - media_player.living_room_soundbar
#     commands:
#       turn_on:
#         action: media_player.turn_on
#         target:
#           entity_id: media_player.living_room_tv
#       turn_off:
#         action: media_player.turn_off
#         target:
#           entity_id: media_player.living_room_tv
#       volume_up:
#         action: media_player.volume_up
#         target:
#           entity_id: media_player.living_room_soundbar
#       volume_down:
#         action: media_player.volume_down
#         target:
#           entity_id: media_player.living_room_soundbar
#       volume_mute:
#         action: media_player.volume_mute
#         target:
#           entity_id: media_player.living_room_soundbar

# Expose the discovered fan / light / media_player / climate entities in
# Settings → Voice assistants → Expose, or with Nabu Casa / Google Assistant
# YAML. Do not expose Tuya's own remotes.
#
# Extra TV IR keys (Home, Netflix, d-pad, HDMI cycle, settings, …) appear as
# button.* entities on the same MQTT device. Use those in Lovelace / automations;
# Google Home will not get a Netflix/Home intent from IR.
